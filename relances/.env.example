# Modèle des variables d'environnement. Ne JAMAIS mettre de vraie clé dans ce fichier.
# En ligne, les valeurs se règlent dans Vercel > Settings > Environment Variables.
#
# ⚠️ Règle d'or : seules les variables qui commencent par NEXT_PUBLIC_ sont visibles dans le navigateur.
# N'y mettez JAMAIS une clé secrète. Toutes les autres restent sur le serveur.

# --- Publiques (visibles dans le navigateur, c'est normal) ---
# Supabase > Project Settings > API : URL du projet et clé « publishable » (protégée par les règles RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Adresse du site, ex. https://encaissez.fr
NEXT_PUBLIC_SITE_URL=
# Code de vérification Google Search Console (facultatif)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --- Secrètes (serveur uniquement, type « Sensitive » sur Vercel) ---
# Supabase : clé secrète, utilisée par le passage quotidien (cron). Contourne les règles RLS !
SUPABASE_SERVICE_ROLE_KEY=
# Resend : envoi des e-mails (sans clé en local, les e-mails s'affichent dans la console)
RESEND_API_KEY=
EMAIL_FROM="Encaissez <relances@mondomaine.fr>"
# Protège /api/cron
CRON_SECRET=
# Stripe : abonnements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Claude : import de factures PDF (facultatif)
ANTHROPIC_API_KEY=
